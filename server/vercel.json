{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    {
    "src": "/(.*)",
    "dest": "/server.js",
    "methods": ["GET","POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
    "Access-Control-Allow-Origin": "https://ai-sustainability-global-summit.gemi-ai.tech/"
    }
  ]
}